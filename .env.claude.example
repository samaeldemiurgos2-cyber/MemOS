# MemOS Claude Code Integration - Environment Template
# Copy this to .env and fill in your values, OR set these directly
# in the "env" block of ~/.claude/settings.json under the memos MCP server.
#
# This configuration targets: Ollama (local LLM) + tree_text (Neo4j graph memory)

# ── Ollama ────────────────────────────────────────────────────────────────────
# Ollama server base URL (default: http://localhost:11434)
OLLAMA_API_BASE=http://localhost:11434

# Chat/reasoning model. Must be pulled with: ollama pull <model>
# Recommended: llama3.2, mistral, qwen2.5, phi4
OLLAMA_CHAT_MODEL=llama3.2

# Embedding model. Must be pulled with: ollama pull nomic-embed-text
# nomic-embed-text produces 768-dimensional embeddings (matches EMBEDDING_DIMENSION below)
OLLAMA_EMBEDDER_MODEL=nomic-embed-text:latest

# Embedding vector dimension — must match the model above
# nomic-embed-text = 768, mxbai-embed-large = 1024
EMBEDDING_DIMENSION=768

# ── Neo4j (for tree_text memory) ─────────────────────────────────────────────
# Neo4j bolt connection URL
NEO4J_URI=bolt://localhost:7687

# Neo4j credentials (set during Neo4j setup)
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Database name (Community Edition only supports "neo4j")
NEO4J_DB_NAME=neo4j

# ── MemOS settings ────────────────────────────────────────────────────────────
# User ID for memory isolation (used as a namespace)
MOS_USER_ID=claude_user

# LLM generation settings
MOS_CHAT_TEMPERATURE=0.7
MOS_MAX_TOKENS=2048
